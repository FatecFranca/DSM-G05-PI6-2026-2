[Unit]
Description=Estoque Inteligente PostgreSQL Backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=MerlinTroll
Group=MerlinTroll
SupplementaryGroups=docker
WorkingDirectory=/home/MerlinTroll/estoque-inteligente
EnvironmentFile=/etc/estoque-inteligente/api.env
Environment=BACKUP_RETENTION_DAYS=3
Environment=BACKUP_DIR=/var/lib/estoque-inteligente-backups
Environment=PATH=/usr/local/bin:/usr/bin:/bin
StateDirectory=estoque-inteligente-backups
StateDirectoryMode=0700
ExecStart=/home/MerlinTroll/estoque-inteligente/scripts/backup-database.sh
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
