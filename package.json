{
  "name": "dsm-g05-pi6-2026-2",
  "version": "0.1.0",
  "private": true,
  "description": "Gestão inteligente de estoque e previsão de demanda",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=@estoque-inteligente/api",
    "dev:web": "npm run dev --workspace=@estoque-inteligente/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File infra/database/start-local.ps1",
    "db:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File infra/database/stop-local.ps1",
    "db:migrate": "npm run db:migrate --workspace=@estoque-inteligente/api",
    "db:seed": "npm run db:seed --workspace=@estoque-inteligente/api",
    "db:setup": "npm run db:start && npm run db:migrate && npm run db:seed",
    "mobile": "cd apps/mobile && flutter run",
    "desktop": "cd apps/mobile && flutter run -d windows"
  },
  "devDependencies": {
    "concurrently": "9.2.4"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  }
}
