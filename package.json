{
  "name": "dsm-g05-pi6-2026-2",
  "version": "0.1.0",
  "private": true,
  "description": "Gestão inteligente de estoque e previsão de demanda",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=@estoque-inteligente/api",
    "dev:web": "npm run dev --workspace=@estoque-inteligente/web",
    "worker:outbox": "npm run worker:outbox --workspace=@estoque-inteligente/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:start": "node scripts/check-database.mjs",
    "db:check": "node scripts/check-database.mjs",
    "db:stop": "node scripts/check-database.mjs --stop",
    "db:legacy:start": "powershell -NoProfile -ExecutionPolicy Bypass -File infra/database/start-local.ps1",
    "db:legacy:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File infra/database/stop-local.ps1",
    "db:migrate": "npm run db:migrate --workspace=@estoque-inteligente/api",
    "db:seed": "npm run db:seed --workspace=@estoque-inteligente/api",
    "user:promote": "npm run user:promote --workspace=@estoque-inteligente/api --",
    "db:setup": "npm run db:start && npm run db:migrate && npm run db:seed",
    "ml:setup": "node scripts/run-python.mjs -m pip install -r apps/ml/requirements.txt",
    "data:download": "node scripts/run-python.mjs -m apps.ml.src.download_dataset",
    "data:load": "node scripts/run-python.mjs -m apps.ml.src.ingest_dataset",
    "data:demo": "node scripts/run-python.mjs -m apps.ml.src.simulate_dataset",
    "ml:demo": "node scripts/run-python.mjs -m apps.ml.src.train_models --dataset demo-brl",
    "ml:train": "node scripts/run-python.mjs -m apps.ml.src.train_models",
    "ml:study": "node scripts/run-python.mjs -m apps.ml.src.preprocessing_study",
    "data:setup": "npm run db:migrate && npm run data:download && npm run data:load && npm run ml:train",
    "test:ml": "node scripts/run-python.mjs -m unittest discover -s apps/ml/tests -p test_*.py",
    "mobile": "cd apps/mobile && flutter run",
    "desktop": "cd apps/mobile && flutter run -d windows"
  },
  "devDependencies": {
    "concurrently": "9.2.4"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  }
}
