{
  "name": "@estoque-inteligente/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API REST do Estoque Inteligente",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/infrastructure/database/migrate.ts",
    "db:seed": "tsx src/infrastructure/database/seed.ts",
    "lint": "eslint .",
    "test": "tsx --test test/**/*.test.ts",
    "test:integration": "tsx test/run-integration.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "fastify": "5.12.1",
    "nodemailer": "^10.0.3",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "eslint": "9.39.5",
    "globals": "16.4.0",
    "pino-pretty": "13.1.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=22"
  }
}
