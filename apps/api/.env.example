HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://estoque_app:troque-esta-senha@127.0.0.1:5433/estoque_inteligente
DB_POOL_MAX=10
WEB_URL=http://localhost:3000
# Cadastro aberto no desenvolvimento; fechado por padrão em produção.
REGISTRATION_ENABLED=true
# file salva e-mails de desenvolvimento em .local/mail (ignorado no Git).
# Produção exige smtp e WEB_URL com HTTPS.
MAIL_MODE=file
MAIL_FROM=noreply@estoque.local
# SMTP_URL=smtps://usuario:senha@servidor:465
# Publicador transacional; deixe disabled quando não houver emulador ou nuvem.
MESSAGING_MODE=disabled
PUBSUB_TOPIC=inventory-domain-events
# GOOGLE_CLOUD_PROJECT=estoque-inteligente-dev
# PUBSUB_EMULATOR_HOST=127.0.0.1:8085
